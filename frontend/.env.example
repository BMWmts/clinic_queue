# URL ของ backend ที่ Next.js (ฝั่ง server) ใช้เรียก API
# ใน docker-compose ให้ใช้ชื่อ service: http://backend:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# URL ของ WebSocket ที่ browser ใช้ต่อโดยตรง (เว้นว่าง = ปิด realtime แล้วใช้ polling แทน)
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# ชื่อระบบที่แสดงบนหน้าจอ
NEXT_PUBLIC_APP_NAME=ระบบจองคิวคลินิก
