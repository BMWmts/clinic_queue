# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามสภาพแวดล้อมจริง
# ห้าม commit ไฟล์ .env ลง git (มี secret จริง)

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL (ค่า default ตรงกับ docker-compose.yml)
DATABASE_URL=postgres://clinic:clinic@127.0.0.1:5432/clinic

# Redis (Celery broker + Channels layer)
REDIS_URL=

# Frontend origin สำหรับ CORS/CSRF
FRONTEND_ORIGIN=http://localhost:3000

# JWT lifetime (นาที / วัน)
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# SMS Gateway — เลือก provider: console | thaibulksms | twilio
# console = เขียนลง log เท่านั้น (ใช้ตอน dev, ไม่ส่งจริง)
SMS_PROVIDER=console
SMS_REMINDER_HOURS_BEFORE=24

# Thai Bulk SMS
THAIBULKSMS_API_KEY=
THAIBULKSMS_API_SECRET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
